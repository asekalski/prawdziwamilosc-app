{
  "expo": {
    "name": "Prawdziwa Miłość",
    "slug": "prawdziwamilosc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prawdziwamilosc.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja potrzebuje dostępu do aparatu, aby umożliwić Ci zrobienie zdjęcia do profilu.",
        "NSPhotoLibraryUsageDescription": "Aplikacja potrzebuje dostępu do galerii, aby umożliwić Ci wybór zdjęcia do profilu.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.prawdziwamilosc.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "prawdziwamilosc.pl",
              "pathPrefix": "/activate"
            },
            {
              "scheme": "prawdziwamilosc"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "prawdziwamilosc",
    "extra": {
      "eas": {
        "projectId": "e3933989-269c-46bc-a273-d6d477e458c3"
      }
    }
  }
}